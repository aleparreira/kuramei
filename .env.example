# WhatsApp (Meta Business API)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_NUMBER=55119XXXXXXXX

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-...

# JWT secret — shared between Lambda (generate_ui tool) and Cloudflare Worker
# Store in AWS Secrets Manager alongside CLOUDFLARE_API_TOKEN
KURAMEI_JWT_SECRET=your-jwt-secret

# Base URL for generated UI links (e.g. https://kuramei.ai)
KURAMEI_BASE_URL=https://kuramei.ai

# Cloudflare KV — used by Lambda via REST API (generate_ui tool)
# Store in AWS Secrets Manager
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# DynamoDB table for reminders (create_reminder tool)
REMINDERS_TABLE=kuramei-reminders

# DynamoDB table for conversation history (sliding window, TTL 30 days)
CONVERSATIONS_TABLE=kuramei-conversations

# DynamoDB table for user profiles and onboarding state
USERS_TABLE=kuramei-users
