# WhatsApp (Meta Business API)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_NUMBER=55119XXXXXXXX

# LLM — DeepSeek API (direct, no OpenRouter)
LLM_API_KEY=sk-...

# JWT secret — shared between Lambda (generate_ui tool) and Vercel UI app
# Store in AWS Secrets Manager and Vercel env vars
KURAMEI_JWT_SECRET=your-jwt-secret

# Base URL for generated UI links — Vercel deployment URL
KURAMEI_BASE_URL=https://kuramei-ui.vercel.app

# DynamoDB — main table (also used for UI spec storage via UI_SPEC# prefix)
DYNAMODB_TABLE=kuramei-main

# DynamoDB table for reminders (create_reminder tool)
REMINDERS_TABLE=kuramei-reminders

# DynamoDB table for conversation history (sliding window, TTL 30 days)
CONVERSATIONS_TABLE=kuramei-conversations

# DynamoDB table for user profiles and onboarding state
USERS_TABLE=kuramei-users

# WhatsApp number for "open WhatsApp" links in UI pages
WHATSAPP_NUMBER=55119XXXXXXXX
