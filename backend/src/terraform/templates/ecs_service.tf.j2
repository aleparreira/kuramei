# ECS Service: {{ node.name }}
# {{ node.description or 'No description provided' }}
{% set cpu = node.properties.get('cpu', 256) %}
{% set memory = node.properties.get('memory', 512) %}
{% set container_port = node.properties.get('container_port', 8080) %}
{% set desired_count = node.properties.get('desired_count', 1) %}
{% set image = node.properties.get('image', 'public.ecr.aws/docker/library/nginx:latest') %}

resource "aws_ecs_cluster" "{{ resource_name }}" {
  name = "{{ node.name | sanitize_name }}-cluster"

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = {
    Name = "{{ node.name }}"
  }
}

resource "aws_ecs_task_definition" "{{ resource_name }}" {
  family                   = "{{ node.name | sanitize_name }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = {{ cpu }}
  memory                   = {{ memory }}
  execution_role_arn       = aws_iam_role.{{ resource_name }}_execution.arn
  task_role_arn            = aws_iam_role.{{ resource_name }}_task.arn

  container_definitions = jsonencode([
    {
      name      = "{{ node.name | sanitize_name }}"
      image     = "{{ image }}"
      essential = true
      portMappings = [
        {
          containerPort = {{ container_port }}
          hostPort      = {{ container_port }}
          protocol      = "tcp"
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = "/ecs/{{ node.name | sanitize_name }}"
          "awslogs-region"        = data.aws_region.current.name
          "awslogs-stream-prefix" = "ecs"
        }
      }
    }
  ])

  tags = {
    Name = "{{ node.name }}"
  }
}

resource "aws_ecs_service" "{{ resource_name }}" {
  name            = "{{ node.name | sanitize_name }}"
  cluster         = aws_ecs_cluster.{{ resource_name }}.id
  task_definition = aws_ecs_task_definition.{{ resource_name }}.arn
  desired_count   = {{ desired_count }}
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = [] # TODO: Add subnet IDs
    security_groups  = [aws_security_group.{{ resource_name }}.id]
    assign_public_ip = false
  }

  tags = {
    Name = "{{ node.name }}"
  }
}

resource "aws_security_group" "{{ resource_name }}" {
  name        = "{{ node.name | sanitize_name }}-sg"
  description = "Security group for {{ node.name }}"
  # vpc_id      = aws_vpc.main.id  # TODO: Add VPC reference

  ingress {
    from_port   = {{ container_port }}
    to_port     = {{ container_port }}
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]  # TODO: Restrict as needed
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ node.name }}-sg"
  }
}

resource "aws_iam_role" "{{ resource_name }}_execution" {
  name = "{{ node.name | sanitize_name }}-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
      }
    ]
  })

  tags = {
    Name = "{{ node.name }}-execution-role"
  }
}

resource "aws_iam_role_policy_attachment" "{{ resource_name }}_execution" {
  role       = aws_iam_role.{{ resource_name }}_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_iam_role" "{{ resource_name }}_task" {
  name = "{{ node.name | sanitize_name }}-task-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
      }
    ]
  })

  tags = {
    Name = "{{ node.name }}-task-role"
  }
}

resource "aws_cloudwatch_log_group" "{{ resource_name }}" {
  name              = "/ecs/{{ node.name | sanitize_name }}"
  retention_in_days = 30

  tags = {
    Name = "{{ node.name }}"
  }
}

data "aws_region" "current" {}
