# S3 Bucket: {{ node.name }}
# {{ node.description or 'No description provided' }}
{% set versioning_enabled = node.properties.get('versioning', True) %}
{% set encryption = node.properties.get('encryption', 'AES256') %}
{% set block_public_access = node.properties.get('block_public_access', True) %}
{% set lifecycle_days = node.properties.get('lifecycle_days', 90) %}

resource "aws_s3_bucket" "{{ resource_name }}" {
  bucket = "{{ node.name | sanitize_name }}-${data.aws_caller_identity.current.account_id}"

  tags = {
    Name = "{{ node.name }}"
  }
}

resource "aws_s3_bucket_versioning" "{{ resource_name }}" {
  bucket = aws_s3_bucket.{{ resource_name }}.id
  versioning_configuration {
    status = "{{ 'Enabled' if versioning_enabled else 'Disabled' }}"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "{{ resource_name }}" {
  bucket = aws_s3_bucket.{{ resource_name }}.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "{{ encryption }}"
    }
  }
}

{% if block_public_access %}
resource "aws_s3_bucket_public_access_block" "{{ resource_name }}" {
  bucket = aws_s3_bucket.{{ resource_name }}.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}
{% endif %}

{% if lifecycle_days %}
resource "aws_s3_bucket_lifecycle_configuration" "{{ resource_name }}" {
  bucket = aws_s3_bucket.{{ resource_name }}.id

  rule {
    id     = "expire-old-versions"
    status = "Enabled"

    noncurrent_version_expiration {
      noncurrent_days = {{ lifecycle_days }}
    }
  }
}
{% endif %}

data "aws_caller_identity" "current" {}
