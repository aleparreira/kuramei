# SQS Queue: {{ node.name }}
# {{ node.description or 'No description provided' }}
{% set fifo = node.properties.get('fifo', False) %}
{% set visibility_timeout = node.properties.get('visibility_timeout_seconds', 30) %}
{% set message_retention = node.properties.get('message_retention_seconds', 345600) %}
{% set max_message_size = node.properties.get('max_message_size', 262144) %}
{% set delay_seconds = node.properties.get('delay_seconds', 0) %}
{% set receive_wait_time = node.properties.get('receive_wait_time_seconds', 0) %}
{% set dlq_enabled = node.properties.get('dlq_enabled', True) %}
{% set max_receive_count = node.properties.get('max_receive_count', 3) %}

resource "aws_sqs_queue" "{{ resource_name }}" {
  name = "{{ node.name | sanitize_name }}{{ '.fifo' if fifo else '' }}"

  visibility_timeout_seconds  = {{ visibility_timeout }}
  message_retention_seconds   = {{ message_retention }}
  max_message_size            = {{ max_message_size }}
  delay_seconds               = {{ delay_seconds }}
  receive_wait_time_seconds   = {{ receive_wait_time }}
  {% if fifo %}
  fifo_queue                  = true
  content_based_deduplication = true
  {% endif %}

  {% if dlq_enabled %}
  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.{{ resource_name }}_dlq.arn
    maxReceiveCount     = {{ max_receive_count }}
  })
  {% endif %}

  tags = {
    Name = "{{ node.name }}"
  }
}

{% if dlq_enabled %}
resource "aws_sqs_queue" "{{ resource_name }}_dlq" {
  name = "{{ node.name | sanitize_name }}-dlq{{ '.fifo' if fifo else '' }}"

  message_retention_seconds = 1209600  # 14 days
  {% if fifo %}
  fifo_queue                  = true
  content_based_deduplication = true
  {% endif %}

  tags = {
    Name = "{{ node.name }}-dlq"
  }
}
{% endif %}
