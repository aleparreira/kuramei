# Terraform Outputs
# Generated by Kuramei

{% for node in nodes %}
{% set resource_name = node.name | sanitize_name %}
{% if node.type == 'vpc' %}
output "{{ resource_name }}_vpc_id" {
  description = "VPC ID for {{ node.name }}"
  value       = aws_vpc.{{ resource_name }}.id
}

output "{{ resource_name }}_vpc_cidr" {
  description = "VPC CIDR for {{ node.name }}"
  value       = aws_vpc.{{ resource_name }}.cidr_block
}

{% elif node.type == 'subnet' %}
output "{{ resource_name }}_subnet_id" {
  description = "Subnet ID for {{ node.name }}"
  value       = aws_subnet.{{ resource_name }}.id
}

{% elif node.type == 'service' %}
output "{{ resource_name }}_cluster_arn" {
  description = "ECS Cluster ARN for {{ node.name }}"
  value       = aws_ecs_cluster.{{ resource_name }}.arn
}

output "{{ resource_name }}_service_name" {
  description = "ECS Service name for {{ node.name }}"
  value       = aws_ecs_service.{{ resource_name }}.name
}

{% elif node.type == 'database' %}
output "{{ resource_name }}_endpoint" {
  description = "RDS endpoint for {{ node.name }}"
  value       = aws_db_instance.{{ resource_name }}.endpoint
}

output "{{ resource_name }}_secret_arn" {
  description = "Secrets Manager ARN for {{ node.name }} credentials"
  value       = aws_secretsmanager_secret.{{ resource_name }}.arn
}

{% elif node.type == 'queue' %}
output "{{ resource_name }}_queue_url" {
  description = "SQS Queue URL for {{ node.name }}"
  value       = aws_sqs_queue.{{ resource_name }}.url
}

output "{{ resource_name }}_queue_arn" {
  description = "SQS Queue ARN for {{ node.name }}"
  value       = aws_sqs_queue.{{ resource_name }}.arn
}

{% elif node.type == 'bucket' %}
output "{{ resource_name }}_bucket_name" {
  description = "S3 bucket name for {{ node.name }}"
  value       = aws_s3_bucket.{{ resource_name }}.id
}

output "{{ resource_name }}_bucket_arn" {
  description = "S3 bucket ARN for {{ node.name }}"
  value       = aws_s3_bucket.{{ resource_name }}.arn
}

{% elif node.type == 'function' %}
output "{{ resource_name }}_function_arn" {
  description = "Lambda function ARN for {{ node.name }}"
  value       = aws_lambda_function.{{ resource_name }}.arn
}

output "{{ resource_name }}_function_name" {
  description = "Lambda function name for {{ node.name }}"
  value       = aws_lambda_function.{{ resource_name }}.function_name
}

{% elif node.type == 'gateway' %}
output "{{ resource_name }}_alb_dns" {
  description = "ALB DNS name for {{ node.name }}"
  value       = aws_lb.{{ resource_name }}.dns_name
}

output "{{ resource_name }}_alb_arn" {
  description = "ALB ARN for {{ node.name }}"
  value       = aws_lb.{{ resource_name }}.arn
}

{% endif %}
{% endfor %}
