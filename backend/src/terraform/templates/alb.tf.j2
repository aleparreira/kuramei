# Application Load Balancer: {{ node.name }}
# {{ node.description or 'No description provided' }}
{% set internal = node.properties.get('internal', False) %}
{% set enable_deletion_protection = node.properties.get('enable_deletion_protection', False) %}
{% set idle_timeout = node.properties.get('idle_timeout', 60) %}
{% set ssl_certificate_arn = node.properties.get('ssl_certificate_arn', '') %}

resource "aws_lb" "{{ resource_name }}" {
  name               = "{{ node.name | sanitize_name }}"
  internal           = {{ 'true' if internal else 'false' }}
  load_balancer_type = "application"
  security_groups    = [aws_security_group.{{ resource_name }}.id]
  subnets            = []  # TODO: Add subnet IDs

  enable_deletion_protection = {{ 'true' if enable_deletion_protection else 'false' }}
  idle_timeout               = {{ idle_timeout }}

  tags = {
    Name = "{{ node.name }}"
  }
}

resource "aws_lb_listener" "{{ resource_name }}_http" {
  load_balancer_arn = aws_lb.{{ resource_name }}.arn
  port              = 80
  protocol          = "HTTP"

  {% if ssl_certificate_arn %}
  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
  {% else %}
  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      message_body = "OK"
      status_code  = "200"
    }
  }
  {% endif %}
}

{% if ssl_certificate_arn %}
resource "aws_lb_listener" "{{ resource_name }}_https" {
  load_balancer_arn = aws_lb.{{ resource_name }}.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = "{{ ssl_certificate_arn }}"

  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      message_body = "OK"
      status_code  = "200"
    }
  }
}
{% endif %}

resource "aws_lb_target_group" "{{ resource_name }}" {
  name        = "{{ node.name | sanitize_name }}-tg"
  port        = 80
  protocol    = "HTTP"
  vpc_id      = null  # TODO: Add VPC ID
  target_type = "ip"

  health_check {
    enabled             = true
    healthy_threshold   = 3
    interval            = 30
    matcher             = "200"
    path                = "/health"
    port                = "traffic-port"
    protocol            = "HTTP"
    timeout             = 5
    unhealthy_threshold = 2
  }

  tags = {
    Name = "{{ node.name }}-tg"
  }
}

resource "aws_security_group" "{{ resource_name }}" {
  name        = "{{ node.name | sanitize_name }}-sg"
  description = "Security group for {{ node.name }}"
  # vpc_id      = aws_vpc.main.id  # TODO: Add VPC reference

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ node.name }}-sg"
  }
}
