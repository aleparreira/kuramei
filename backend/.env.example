# Kuramei Backend - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for local development)
DATABASE_URL=sqlite+aiosqlite:///./data/kuramei.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kuramei

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Anthropic Claude (primary)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model selection (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# APPLICATION
# =============================================================================
# Debug mode (enables SQL echo, detailed errors)
DEBUG=true

# App name (shown in API docs)
# APP_NAME=Kuramei API

# =============================================================================
# CORS
# =============================================================================
# Additional CORS origins (comma-separated)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
