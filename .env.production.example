# ============================================================
# Kuramei — Variáveis de Ambiente para Produção (Lambda)
# ============================================================
# Este arquivo lista as chaves obrigatórias SEM valores.
# Os valores reais ficam no AWS Secrets Manager.
# Consulte o runbook (docs/runbook-deploy.md) para instruções.
# ============================================================

# --- WhatsApp / Meta ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=

# --- DynamoDB ---
DYNAMODB_TABLE=kuramei-main
REMINDERS_TABLE=kuramei-reminders

# --- UI Engine ---
KURAMEI_JWT_SECRET=
KURAMEI_BASE_URL=https://app.kuramei.app

# --- Cloudflare (para generate_ui tool) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=

# --- Lambda: agent-processor ---
# ARN preenchido automaticamente pelo CDK
AGENT_PROCESSOR_ARN=
